# Copy to .env, supply local credentials, then export before starting Spring Boot.
# Spring Boot does not automatically load this file. See README.md.
DB_URL=jdbc:postgresql://localhost:5432/custerra
DB_USERNAME=custerra
DB_PASSWORD=replace-with-your-local-password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Official USGS earthquake catalog; no API key required.
USGS_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_CONNECT_TIMEOUT_MS=3000
USGS_READ_TIMEOUT_MS=10000

# Default Open-Meteo endpoint is for non-commercial use; see docs/data-sources.md.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_CONNECT_TIMEOUT_MS=3000
OPEN_METEO_READ_TIMEOUT_MS=10000

# Periodic journey checks are opt-in. Only ACTIVE journeys are checked.
MONITORING_ENABLED=false
MONITORING_INTERVAL_MS=300000

# Keep local development bound to loopback. Use HTTPS and secure cookies for deployment.
SESSION_COOKIE_SECURE=false
SERVER_ADDRESS=127.0.0.1

# NASA FIRMS VIIRS Suomi NPP observations. Empty key reports UNAVAILABLE; never a successful empty result.
FIRMS_MAP_KEY=
FIRMS_CONNECT_TIMEOUT_MS=3000
FIRMS_READ_TIMEOUT_MS=10000
GDACS_ENABLED=true
GDACS_CONNECT_TIMEOUT_MS=3000
GDACS_READ_TIMEOUT_MS=10000

# Place search / driving route providers. Free defaults require modest, non-commercial use.
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
ROUTING_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
PLANNING_CONNECT_TIMEOUT_MS=3000
PLANNING_READ_TIMEOUT_MS=10000

# Outbound web push is opt-in and disabled until configured. Do not commit real keys.
NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Operations: keep this distinct from API-client and provider credentials.
OPS_TOKEN=
PUBLIC_REQUESTS_PER_MINUTE=120
# Hosted production also requires verified DB TLS, HTTPS CORS origins and secure cookies.
# SPRING_PROFILES_ACTIVE=production
